{
  "name": "nt-studio",
  "version": "0.1.0",
  "description": "NT Studio — وكيل سطح مكتب شخصي يبني مشاريع حقيقية بالذكاء الاصطناعي",
  "author": "NT",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:encoding": "node scripts/check-encoding.mjs",
    "build": "npm run typecheck && npm run check:encoding && electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run check:encoding && npm test && electron-vite build",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/google": "^4.0.88",
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/openai-compatible": "^3.0.63",
    "ai": "^7.0.128",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}