{
  "name": "nt-studio",
  "productName": "NT Studio",
  "version": "1.0.0",
  "description": "بيئة عمل شخصية لنموذج ذكاء اصطناعي على سطح المكتب: ملفات وتنفيذ ومتصفح وتحكم كامل بالكمبيوتر",
  "main": "./out/main/index.js",
  "author": "NT",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify:agent-fixes": "node scripts/verify-agent-fixes.mjs",
    "memory": "node --no-warnings --experimental-transform-types scripts/seed-memory.mjs",
    "memory:write": "node --no-warnings --experimental-transform-types scripts/seed-memory.mjs --write",
    "test:opencode": "node --test tests/opencode.test.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "run:latest": "powershell -ExecutionPolicy Bypass -File ./Run-Latest.ps1",
    "postinstall": "node node_modules/electron/install.js && (electron-builder install-app-deps || exit 0)"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/noto-kufi-arabic": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "44.9.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.0",
    "lucide-react": "^0.540.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.0.0"
  }
}
